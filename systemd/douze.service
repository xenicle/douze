# Douze — GUI web locale pour la SSL 12 (http://localhost:1212)
#
# Service utilisateur. À ADAPTER avant usage : `WorkingDirectory` doit pointer là
# où vous avez cloné le dépôt.
#
#   sed "s|%h/douze|$PWD|" systemd/douze.service > ~/.config/systemd/user/douze.service
#   systemctl --user daemon-reload && systemctl --user enable --now douze
#
# Le seul prérequis est python3 + pyusb.
#
# Sous Nix, pour prendre les dépendances du devShell plutôt que celles du
# système, remplacer ExecStart par :
#   ExecStart=/run/current-system/sw/bin/nix develop %h/douze --command python tools/douze.py
[Unit]
Description=Douze - GUI SSL 12
# pas de After=réseau : tout est local ; le device peut arriver plus tard,
# d'où le Restart en boucle tant que la SSL 12 n'est pas là.
#
# En revanche il FAUT attendre la session graphique. Lancé au démarrage de la
# machine (WantedBy=default.target), le démon partait avant que le compositeur
# n'ait publié DISPLAY / WAYLAND_DISPLAY dans l'environnement de systemd --user,
# et ses bandes en héritaient : l'audio marchait, mais Wine n'avait plus de
# pilote graphique, l'ouverture d'un éditeur de plugin ne rendait jamais la main,
# et le deadman de Douze FX inscrivait le plugin comme « éditeur bloquant » —
# définitivement. Deux plugins sains ont été condamnés ainsi le 19/08/2026.
#
# `WantedBy=graphical-session.target` (sans PartOf) : on DÉMARRE avec la session,
# on ne s'arrête pas avec elle — la carte reste configurée si le compositeur
# tombe ou redémarre.
After=graphical-session.target

[Service]
# Sans ça, la sortie de Python est bufferisée par BLOCS dès qu'elle ne va pas
# vers un terminal : les messages du démon (état restauré, bandes relancées,
# applications rebranchées) n'arrivaient dans `journalctl` qu'au bout de
# plusieurs kilo-octets, donc en pratique jamais. Un service dont on ne peut pas
# lire le journal ne se diagnostique pas.
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=%h/douze
# Chemin ABSOLU obligatoire : systemd refuse `python3` tout court
# (« Command python3 is not executable »). `/usr/bin/env` est le
# chemin absolu portable qui retrouve le bon python.
ExecStart=/usr/bin/env python3 tools/douze.py
# Le démon arrête ses bandes lui-même sur SIGTERM, mais un moteur peut traîner
# sur un teardown Wine. 20 s suffisent largement à son garde-fou interne (8 s) —
# au-delà, mieux vaut un SIGKILL rapide qu'un « redémarrage » qui a l'air figé.
# SIGTERM au démon SEUL, puis SIGKILL immédiat du reste dès qu'il a rendu la
# main. Sans ça, systemd attend aussi les `winedevice.exe` que yabridge laisse
# derrière lui — ils ne s'arrêtent jamais poliment, et on payait le délai entier
# à chaque redémarrage.
KillMode=mixed
TimeoutStopSec=20
Restart=on-failure
RestartSec=10

[Install]
WantedBy=graphical-session.target
